---
import type { HoroscopeData, ZodiacSign } from '../types';

interface Props {
  sign: ZodiacSign;
  horoscope: HoroscopeData;
  periodLabel: string;
  previousHref?: string;
  nextHref?: string;
}
const { sign, horoscope, periodLabel, previousHref, nextHref } = Astro.props;
const categories = [
  ['love', '爱情'], ['career', '事业'], ['health', '状态'], ['wealth', '财富'],
] as const;
---

<main class="min-h-screen bg-moon px-4 pb-16 pt-8 sm:px-6">
  <div class="mx-auto max-w-5xl">
    <nav aria-label="面包屑" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-ink/55">
      <a href="/" class="font-bold transition-colors hover:text-dusk">今日运势</a><span>›</span><a href={`/${sign.id}/`} class="font-bold transition-colors hover:text-dusk">{sign.name}</a><span>›</span><span>{periodLabel}</span>
    </nav>

    <header class="sticker relative overflow-hidden bg-dusk p-6 text-white shadow-[6px_6px_0_#372c86] sm:p-10">
      
      
      <div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <div><p class="text-xs font-black tracking-[.16em] text-gold">{periodLabel.toUpperCase()} · {horoscope.dateRange}</p><h1 class="mt-3 text-3xl font-black leading-tight sm:text-5xl">{sign.icon} {sign.name}：{horoscope.theme}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-white/80">{horoscope.summary}</p></div>
        <div class="text-left md:text-right"><div class="text-sm text-white/70">综合指数</div><div class="mt-1 text-7xl font-black tracking-tight text-gold">{horoscope.overall}</div></div>
      </div>
    </header>

    <section class="mt-5 grid gap-3 sm:grid-cols-2">
      {categories.map(([key, label]) => {
        const item = horoscope.dimensions[key];
        return <article class="sticker-sm bg-white p-5"><div class="flex items-center justify-between"><h2 class="font-semibold text-ink">{label}</h2><strong class="text-2xl font-black text-ink">{item.score}</strong></div><div class="mt-3 h-2.5 overflow-hidden rounded-full border-2 border-outline bg-white"><div class="h-full bg-dusk" style={`width:${item.score}%`}></div></div><p class="mt-4 text-sm leading-7 text-ink/75">{item.summary}</p></article>;
      })}
    </section>

    <section class="mt-5 grid gap-4 lg:grid-cols-[1.2fr_.8fr]">
      <article class="sticker bg-white p-6"><div class="grid gap-5 sm:grid-cols-2"><div><h2 class="font-black text-ink">适合推进</h2><ul class="mt-3 space-y-2 text-ink/75">{horoscope.actions.map((item) => <li>· {item}</li>)}</ul></div><div><h2 class="font-black text-ink">需要留意</h2><ul class="mt-3 space-y-2 text-ink/75">{horoscope.cautions.map((item) => <li>· {item}</li>)}</ul></div></div>{horoscope.keyDates.length > 0 && <div class="mt-6 border-t-2 border-outline/15 pt-5"><h2 class="font-semibold">关键日期</h2><div class="mt-3 flex flex-wrap gap-2">{horoscope.keyDates.map((item) => <span class="sticker-chip bg-cream px-3 py-2 text-sm text-ink">{item}</span>)}</div></div>}</article>
      <aside class="sticker bg-white p-6"><h2 class="font-semibold">幸运提示</h2><dl class="mt-4 space-y-4 text-sm">{[['幸运色', horoscope.luckyColor], ['幸运数字', horoscope.luckyNumber], ['舒展时间', horoscope.luckyTime]].map(([label, value]) => <div class="flex justify-between border-b-2 border-outline/10 pb-3"><dt class="text-ink/55">{label}</dt><dd class="font-black">{value}</dd></div>)}</dl><button id="share-period" type="button" class="sticker-btn-sm mt-5 min-h-11 w-full cursor-pointer bg-gold px-4 font-black text-ink">分享此页</button></aside>
    </section>

    <nav aria-label="周期导航" class="mt-6 flex items-center justify-between gap-4">{previousHref ? <a href={previousHref} class="sticker-btn-sm bg-white px-4 py-3 text-sm font-black text-ink">← 上一周期</a> : <span></span>}{nextHref && <a href={nextHref} class="sticker-btn-sm bg-white px-4 py-3 text-sm font-black text-ink">下一周期 →</a>}</nav>
    <p class="mx-auto mt-8 max-w-3xl text-center text-xs leading-6 text-ink/50">{horoscope.disclaimer}</p>
  </div>
</main>

<script is:inline>
  document.getElementById('share-period')?.addEventListener('click', async function () {
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url: location.href }); window.gtag?.('event', 'share_completed', { type: 'period_link', method: 'native' }); return; } catch (error) { if (error && error.name === 'AbortError') return; }
    }
    await navigator.clipboard?.writeText(location.href); this.textContent = '链接已复制';
    window.gtag?.('event', 'share_completed', { type: 'period_link', method: 'clipboard' });
  });
</script>
