---
import Layout from '../layouts/Layout.astro';
import ReactApp from '../components/ReactApp';
import { elementNames, getISOWeek, zodiacSigns } from '../data/zodiac';
import { Footer } from '../sections/Footer';

const today = new Date(); const week = getISOWeek(today);
const canonical = new URL('/', Astro.site).href;
const faqs = [
  { q: '今日运势的内容如何生成？', a: '内容基于星座主题、完整日期和内容周期，通过稳定规则生成。同一星座在同一日期的结果保持一致，不同年份和不同周期会使用不同内容。' },
  { q: '内容可以替我做决定吗？', a: '不能。本站内容仅供娱乐与日常生活参考，尤其不应替代医疗、财务、法律或关系中的专业意见与真实沟通。' },
  { q: '每天什么时候更新？', a: '首页和当天页面每日更新，并提供每周、每月主题，帮助你从不同时间尺度整理生活节奏。' },
  { q: '星座档案会上传吗？', a: '轻量星座档案默认只保存在当前设备，不需要注册，也不会将出生日期上传到服务器。' },
];
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: '今日运势', url: canonical, description: '十二星座每日、每周、每月运势与配对', applicationCategory: 'LifestyleApplication', inLanguage: 'zh-CN' }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }];
---
<Layout title="今日运势 - 十二星座每日、每周与每月运势" description="十二星座每日、每周、每月运势与星座配对。用轻量、克制的星座主题解读，整理今天值得关注的事。" canonical={canonical} jsonLd={jsonLd}>
  <ReactApp client:only="react" />
  <section class="border-t-[3px] border-outline bg-moon px-5 py-16 sm:px-8" aria-labelledby="explore-title"><div class="mx-auto max-w-6xl"><p class="text-xs font-black tracking-[.16em] text-dusk">继续探索</p><h2 id="explore-title" class="mt-2 text-3xl font-black sm:text-4xl">按星座往下看</h2><div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">{zodiacSigns.map((sign) => <article class="sticker bg-white p-4"><a href={`/${sign.id}/`} class="block"><span class="zodiac-glyph text-3xl leading-none">{sign.icon}</span><h3 class="mt-4 font-black">{sign.name}</h3><p class="mt-1 text-xs text-ink/55">{elementNames[sign.element]} · {sign.dateRange}</p></a><div class="mt-4 flex gap-2 text-xs font-bold"><a href={`/weekly/${sign.id}/${week.year}/${week.week}/`} class="text-dusk hover:underline">周运</a><a href={`/monthly/${sign.id}/${today.getFullYear()}/${today.getMonth() + 1}/`} class="text-dusk hover:underline">月运</a></div></article>)}</div></div></section>
  <section class="border-t-2 border-outline/15 bg-haze px-5 py-10 sm:px-8" aria-labelledby="faq-title"><div class="mx-auto max-w-4xl"><details class="group"><summary class="flex min-h-12 cursor-pointer items-center justify-between text-sm font-black text-ink/70"><span id="faq-title">常见问题</span><span class="text-xs font-bold text-ink/45 group-open:hidden">展开</span><span class="hidden text-xs font-bold text-ink/45 group-open:inline">收起</span></summary><div class="mt-4 space-y-3">{faqs.map((item) => <details class="sticker-sm bg-white p-4"><summary class="cursor-pointer text-sm font-black text-ink">{item.q}</summary><p class="mt-3 max-w-3xl text-sm leading-7 text-ink/70">{item.a}</p></details>)}</div></details></div></section>
  <Footer />
  <script is:inline>
    (function () { var now = new Date(); document.querySelectorAll('a[href*="/weekly/"]').forEach(function (link) { /* Static fallback remains valid for crawlers; React homepage calculates the live period. */ }); })();
  </script>
</Layout>
