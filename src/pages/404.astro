---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到 - 今日运势">
  <main class="flex min-h-screen items-center justify-center bg-moon px-4">
    <div class="text-center">
      <h1 class="text-7xl font-black text-dusk">404</h1>
      <p class="mt-3 mb-8 text-xl text-ink/70">页面未找到</p>
      <a href="/" class="sticker-btn inline-flex min-h-12 items-center bg-gold px-6 font-black text-ink">
        返回首页查看运势
      </a>
    </div>
  </main>
</Layout>
