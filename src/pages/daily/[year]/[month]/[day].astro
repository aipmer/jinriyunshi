---
import Layout from '../../../../layouts/Layout.astro';
import { generateHoroscope, zodiacSigns } from '../../../../data/zodiac';

export function getStaticPaths() {
  const paths = [];
  for (const year of [2026, 2027]) for (let month = 1; month <= 12; month += 1) for (let day = 1; day <= new Date(year, month, 0).getDate(); day += 1) paths.push({ params: { year: String(year), month: String(month), day: String(day) } });
  return paths;
}
const year = Number(Astro.params.year); const month = Number(Astro.params.month); const day = Number(Astro.params.day); const date = new Date(year, month - 1, day);
const ranked = zodiacSigns.map((sign) => ({ sign, horoscope: generateHoroscope(sign.id, date) })).sort((a, b) => b.horoscope.overall - a.horoscope.overall);
const canonical = new URL(`/daily/${year}/${month}/${day}/`, Astro.site).href;
---
<Layout title={`${year}年${month}月${day}日十二星座运势 - 今日运势`} description={`${year}年${month}月${day}日十二星座运势排行与详细解读入口。`} canonical={canonical}>
  <main class="min-h-screen bg-moon px-4 py-8 sm:px-6"><div class="mx-auto max-w-5xl"><nav class="mb-8 text-sm text-slate-500"><a href="/" class="hover:text-dusk">今日运势</a> <span class="mx-2">›</span> 每日总览</nav><header><p class="text-sm font-semibold tracking-[.18em] text-dusk">DAILY OVERVIEW</p><h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-5xl">{year}年{month}月{day}日<br />十二星座运势</h1><p class="mt-4 text-slate-600">快速浏览今日主题，选择你的星座查看完整解读。</p></header><section class="mt-10 grid gap-3 sm:grid-cols-2">{ranked.map(({ sign, horoscope }, index) => <a href={`/${sign.id}/${year}/${month}/${day}/`} class="group rounded-[18px] border border-dusk/10 bg-white p-5 transition-[transform,border-color] hover:-translate-y-0.5 hover:border-dusk/30"><div class="flex items-center gap-4"><span class="w-8 text-center text-sm font-semibold text-slate-400">{String(index + 1).padStart(2, '0')}</span><span class="text-3xl">{sign.icon}</span><div class="min-w-0 flex-1"><h2 class="font-semibold">{sign.name} · {horoscope.theme}</h2><p class="mt-1 truncate text-sm text-slate-500">{horoscope.summary}</p></div><strong class="text-2xl text-dusk">{horoscope.overall}</strong></div></a>)}</section><p class="mt-8 text-center text-xs text-slate-500">内容基于星座主题生成，仅供娱乐与日常生活参考。</p></div></main>
</Layout>
