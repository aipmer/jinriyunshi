---
import Layout from '../../layouts/Layout.astro';
import { elementNames, generateHoroscope, getISOWeek, personalityProfiles, zodiacSigns } from '../../data/zodiac';

export function getStaticPaths() { return zodiacSigns.map((sign) => ({ params: { sign: sign.id }, props: { sign } })); }
const { sign } = Astro.props; const profile = personalityProfiles[sign.id]; const today = new Date(); const week = getISOWeek(today);
const recent = Array.from({ length: 7 }, (_, index) => { const date = new Date(today); date.setDate(date.getDate() - index); return { date, horoscope: generateHoroscope(sign.id, date) }; });
const otherSigns = zodiacSigns.filter((item) => item.id !== sign.id);
const canonical = new URL(`/${sign.id}/`, Astro.site).href;
---
<Layout title={`${sign.name}性格与近期运势 - 今日运势`} description={`${sign.name}性格、优势、常见盲区、爱情模式、职场特点与近期运势。`} canonical={canonical}>
  <main class="min-h-screen bg-moon px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <nav class="mb-8 text-sm font-medium text-ink/55"><a href="/" class="font-bold hover:text-dusk">今日运势</a> <span class="mx-2">›</span> {sign.name}</nav>
      <header class="sticker relative overflow-hidden bg-dusk p-7 text-white shadow-[6px_6px_0_#372c86] sm:p-10"><p class="text-xs font-black tracking-[.16em] text-gold">{elementNames[sign.element].toUpperCase()} SIGN · {sign.dateRange}</p><h1 class="mt-3 text-4xl font-black sm:text-6xl">{sign.icon} {sign.name}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-white/80">{profile.core}</p><div class="mt-7 flex flex-wrap gap-3"><a href={`/${sign.id}/${today.getFullYear()}/${today.getMonth() + 1}/${today.getDate()}/`} class="sticker-btn-sm inline-flex min-h-12 items-center bg-gold px-5 font-black text-ink">查看今日运势</a><a href={`/weekly/${sign.id}/${week.year}/${week.week}/`} class="sticker-btn-sm inline-flex min-h-12 items-center bg-white px-5 font-black text-ink">查看本周运势</a><a href={`/monthly/${sign.id}/${today.getFullYear()}/${today.getMonth() + 1}/`} class="sticker-btn-sm inline-flex min-h-12 items-center bg-white px-5 font-black text-ink">查看本月运势</a></div></header>
      <section class="mt-5 grid gap-4 md:grid-cols-2"><article class="sticker bg-sky p-6"><h2 class="text-xl font-black text-ink">优势</h2><ul class="mt-3 space-y-2 text-ink/75">{profile.strengths.map((item) => <li>· {item}</li>)}</ul></article><article class="sticker bg-blush p-6"><h2 class="text-xl font-black text-ink">常见盲区</h2><ul class="mt-3 space-y-2 text-ink/75">{profile.blindSpots.map((item) => <li>· {item}</li>)}</ul></article>{[['爱情模式', profile.love], ['职场特点', profile.career], ['沟通建议', profile.communication]].map(([title, copy]) => <article class="sticker bg-white p-6"><h2 class="text-xl font-black">{title}</h2><p class="mt-3 leading-7 text-ink/75">{copy}</p></article>)}</section>
      <section class="mt-10"><h2 class="text-2xl font-black">近期运势</h2><div id="sign-recent-days" data-sign={sign.id} class="mt-4 grid gap-3 sm:grid-cols-2">{recent.map(({ date, horoscope }) => <a href={`/${sign.id}/${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}/`} class="sticker-btn-sm bg-white p-5"><div class="flex justify-between"><span class="font-semibold">{date.getMonth() + 1}月{date.getDate()}日</span><strong class="text-xl font-black text-ink">{horoscope.overall}</strong></div><p class="mt-2 line-clamp-2 text-sm text-ink/70">{horoscope.summary}</p></a>)}</div></section>
      <section class="mt-10"><h2 class="text-2xl font-black">探索其他星座</h2><div class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-6">{otherSigns.map((item) => <a href={`/${item.id}/`} class="sticker-btn-sm bg-white p-3 text-center text-sm font-bold text-ink"><span class="zodiac-glyph block text-2xl">{item.icon}</span>{item.name}</a>)}</div></section>
    </div>
  </main>
  <script is:inline>
    (function () { var box = document.getElementById('sign-recent-days'); if (!box) return; var sign = box.dataset.sign; box.querySelectorAll('a').forEach(function (link, index) { var date = new Date(); date.setDate(date.getDate() - index); link.href = '/' + sign + '/' + date.getFullYear() + '/' + (date.getMonth() + 1) + '/' + date.getDate() + '/'; }); })();
  </script>
</Layout>
